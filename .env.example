# Path the site is served under. '/delma' for https://sulayksa.github.io/delma — leave empty on a custom/root domain.
NEXT_PUBLIC_BASE_PATH=/delma
# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://sulayksa.github.io/delma
# Optional: endpoint that receives quote requests (multipart/form-data POST).
# Leave empty to send requests through WhatsApp. Examples: a Cloudflare Pages Function (/api/quote — see functions/api/quote.ts),
# or a form service such as Formspree / Web3Forms.
NEXT_PUBLIC_QUOTE_ENDPOINT=
